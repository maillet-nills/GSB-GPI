<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GSB_GPI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="450"
             x:Class="GSB_GPI.Views.UserItemView"
             x:DataType="vm:UserItemViewModel"
             Background="White">

    <UserControl.Styles>
        <Style Selector="Button.add">
            <Setter Property="Background" Value="#2E9E5B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.add:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#268A4E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.add:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1F7342"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.cancel">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.cancel:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D1D5DB"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
        </Style>
        <Style Selector="Button.cancel:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#9CA3AF"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="24" RowDefinitions="Auto, Auto, *, Auto" RowSpacing="16">

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Nouvel utilisateur" Foreground="#1F1F1F" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Création d'un compte" Foreground="#6B6B6B" FontSize="13"/>
        </StackPanel>

        <Separator Grid.Row="1" Background="#E0E0E0" Margin="0,2"/>

        <Border Grid.Row="2" Background="#F9FAFB" CornerRadius="8" Padding="16" VerticalAlignment="Top">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="10">
                <TextBlock Grid.Row="0" Text="Informations du compte" FontWeight="Bold" Foreground="#1F1F1F" FontSize="15"/>

                <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Nom" Foreground="#6B6B6B" FontSize="12"/>
                        <TextBox Text="{Binding LastName}" Watermark="Nom"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Prénom" Foreground="#6B6B6B" FontSize="12"/>
                        <TextBox Text="{Binding FirstName}" Watermark="Prénom"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock Text="Email" Foreground="#6B6B6B" FontSize="12"/>
                    <TextBox Text="{Binding Email}" Watermark="prenom.nom@gsb.fr"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="2">
                    <TextBlock Text="Rôle" Foreground="#6B6B6B" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <Grid Grid.Row="4" ColumnDefinitions="*, *" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Mot de passe" Foreground="#6B6B6B" FontSize="12"/>
                        <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="Mot de passe"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Confirmer le mot de passe" Foreground="#6B6B6B" FontSize="12"/>
                        <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" Watermark="Confirmation"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="5"
                           Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="#E81733"
                           FontSize="12"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Classes="cancel" Content="Annuler" Command="{Binding CancelCommand}"/>
            <Button Classes="add" Content="Créer" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>