<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GSB_GPI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="570" d:DesignHeight="450"
             x:Class="GSB_GPI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="White">

    <StackPanel Margin="40,36" Spacing="6">
        <TextBlock Text="Tableau de bord"
                   Foreground="#1F1F1F"
                   FontSize="32"
                   FontWeight="Bold"/>
        <TextBlock Text="Contenu à venir"
                   Foreground="#6B6B6B"
                   FontSize="16"/>
    </StackPanel>
</UserControl>